# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Flask
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (local).
# The password lives in backend/secrets/pg_password.txt - NEVER put it here.
# config.py composes DATABASE_URL from PG_* + that file.
PG_USER=postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=facebook_clone
# (optional full override, takes priority over the above)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

# Public URL used to build the verification link inside the email.
# scripts/start.ps1 rewrites this with the live Cloudflare quick-tunnel URL.
PUBLIC_BASE_URL=http://127.0.0.1:5055

# Resend - the API key lives in backend/secrets/resend_api_key.txt.
RESEND_FROM=Facebook <onboarding@resend.dev>
# RESEND_WEBHOOK_SECRET goes in backend/secrets/resend_webhook_secret.txt

# Verification
VERIFY_TTL_MINUTES=15
MIN_PASSWORD_LENGTH=8

# Harness switches
ENABLE_DEV_ENDPOINTS=1
MAX_ADVANCE_SECONDS=2592000
SEED_PASSWORD=password123
